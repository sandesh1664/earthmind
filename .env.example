# Run make setup to generate a random local password. Existing .env values are preserved.
POSTGRES_USER=earthmind
POSTGRES_PASSWORD=
POSTGRES_DB=earthmind
EARTHMIND_DEV_WRITE_TOKEN=
DB_PORT=5434
API_PORT=8000
WEB_PORT=3000
# Compose injects DATABASE_URL, REDIS_URL, CORS_ORIGINS and API_INTERNAL_URL.
# Redis is private to the Compose network and has no host port.
# M02 write endpoints require the private development token generated by make setup.
GEO_MAX_REQUEST_BYTES=262144
GEO_MAX_COORDINATES=5000
GEO_MAX_BBOX_DEGREES=1.0
GEO_MAX_PAGE_SIZE=100
GEO_MAX_RADIUS_M=5000
GEO_MAX_VALIDATION_FEATURES=10000
GEO_MAX_VALIDATION_COORDINATES=100000
GEO_BOUNDARY_TOLERANCE_M=5

# Intentionally PUBLIC ion token: assets:read, required assets and allowed origins only.
# Never use account/admin/upload credentials. Set the canonical variable below.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Legacy alias remains supported; leave empty when using the canonical setting.
CESIUM_ION_PUBLIC_TOKEN=
# Choose an aerial imagery asset available/authorized in YOUR ion account.
# Installed Cesium World Imagery AERIAL asset; access must be granted by your account.
# Legacy asset 3812 returned HTTP 404 during integration verification.
CESIUM_ION_IMAGERY_ASSET_ID=2
CESIUM_ION_TERRAIN_ASSET_ID=1
# Opt-in local diagnostics; disabled by default even for production builds.
CITY_DIAGNOSTICS_ENABLED=false

# Recovery: locally served OpenStreetMap cartography; ion requires public asset access.
CITY_IMAGERY_MODE=local-osm

# M04: bounded single-worker synthetic SUMO experiments; never observed traffic.
SIMULATION_TIMEOUT_SECONDS=600
SIMULATION_QUEUE_LIMIT=20
# Inputs mount read-only; verified outputs persist in the simulation_artifacts volume.
